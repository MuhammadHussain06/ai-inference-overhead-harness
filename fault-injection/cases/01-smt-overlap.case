# python-service on the other hyperthread of each of the Java service's cores, with both
# quotas matched to their cpusets. No logical CPU is shared, so only the SMT sibling
# comparison can tell the two services are on the same hardware.
DESCRIPTION="python-service on the sibling hyperthreads of the Java service's cores"
STAGE="pre-container"
EXPECT_GUARD="[smt]"
REQUIRES="smt"
ENV="PYTHON_CPUSET=${FAULT_SMT_PYTHON} PYTHON_CPUS=${FAULT_SMT_PYTHON_CPUS} JAVA_CPUSET=${FAULT_SMT_JAVA} JAVA_CPUS=${FAULT_SMT_JAVA_CPUS}"
