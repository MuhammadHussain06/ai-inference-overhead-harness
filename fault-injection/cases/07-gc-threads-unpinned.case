# -XX:ParallelGCThreads removed from the JVM options. JVM ergonomics then sizes the pool
# from the cores the host exposes, which on the reference machine yields the pinned value, so
# a value-only check passes; the missing-pin check catches it first.
DESCRIPTION="GC worker thread count left to JVM ergonomics"
STAGE="stack"
EXPECT_GUARD="[jvm-pin]"
ENV=""
PATCH_SET_ENV="transaction-service:JAVA_TOOL_OPTIONS:-Xms1536m -Xmx1536m -XX:+UseG1GC -XX:ConcGCThreads=1 -Dreactor.netty.ioWorkerCount=4 -Xlog:gc*:file=/gc-logs/gc.log:time,uptime,level,tags:filecount=0"