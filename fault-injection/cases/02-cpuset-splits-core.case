# python-service pinned to one hyperthread of its first baseline core (FAULT_HALF_CORE). The
# cpusets stay disjoint, so the SMT comparison passes; the unclaimed sibling stays schedulable
# by the rest of the host, so python-service shares that core's execution units with whatever
# the kernel places there.
DESCRIPTION="python-service takes one hyperthread of each core, not both"
STAGE="pre-container"
EXPECT_GUARD="[cpuset]"
REQUIRES="smt"
ENV="PYTHON_CPUSET=${FAULT_HALF_CORE} PYTHON_CPUS=1.0"