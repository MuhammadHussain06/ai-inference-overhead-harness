# Java
services/transaction-service/target/

# Python
services/fraud-ml-service/**/__pycache__/
services/fraud-ml-service/training/venv/
services/fraud-ml-service/training/data/
analysis/**/__pycache__/
analysis/venv/

# Benchmark raw output -- keep dirs via .gitkeep, ignore their contents.
results/*
!results/.gitkeep
!results/gc-logs/
results/gc-logs/*
!results/gc-logs/.gitkeep

# Analysis output
analysis/output/

# Fault-injection working copies of the compose configuration and per-case run logs.
# The generated report under fault-injection/results/ is kept: it is the evidence that
# the guards fire.
fault-injection/scratch/

# Per-machine, generated by setup.sh -- never committed.
.env

# OS/editor noise
.DS_Store
.idea/
.vscode/fault-injection/verify-guards-console.log
fault-injection/verify-guards-rerun.log
services/fraud-ml-service/.venv/
