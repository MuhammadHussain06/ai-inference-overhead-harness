# Analysis output
analysis/output/

# Fault-injection working copies of the compose configuration and per-case run logs.
# guard_verification_report.{m  d,csv} is host- and run-specific regenerable evidence
# (see README's fault-injection section), not something this repo carries a
# checked-in copy of -- same convention as the main suite's results/ above.
fault-injection/scratch/
fault-injection/results/

# Per-machine, generated by setup.sh -- never committed.
.env

