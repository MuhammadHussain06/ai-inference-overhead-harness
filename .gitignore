# Java
services/transaction-service/target/

# Python
services/fraud-ml-service/**/__pycache__/
services/fraud-ml-service/training/venv/
services/fraud-ml-service/training/data/
analysis/**/__pycache__/
analysis/venv/

# Benchmark output: one directory per run, plus archive/ and logs/ -- keep results/ via .gitkeep.
results/*
!results/.gitkeep

# Analysis output
analysis/output/

# Fault-injection working copies of the compose configuration and per-case run logs.
# guard_verification_report.{md,csv} is host- and run-specific regenerable evidence
# (see README's fault-injection section), not something this repo carries a
# checked-in copy of -- same convention as the main suite's results/ above.
fault-injection/scratch/
fault-injection/results/

# Per-machine, generated by setup.sh -- never committed.
.env

# OS/editor noise
.DS_Store
.idea/
.vscode/
services/fraud-ml-service/.venv/
**/__pycache__/
